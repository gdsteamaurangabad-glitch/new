print(" Program for Best first Search ")
print("*"*34)
graph={
    'S':['A','B'],
    'A':['C','D'],
    'B':['E'],
    'C':['F'],
    'D':['H'],
    'E':['H'],
    'F':['G'],
     'H':['G'],
    'G':[]

}
h={
    'S':10,
    'A':7,
    'B':6,
    'C':5,
    'D':4,
    'E':3,
    'F':2,
    'H':5,
     'G':0
}
start=input("\tEnter Start:")
goal=input("\tEnter Goal:")
open=[start]
while open:
    node=min(open,key=lambda x: h[x])
    open.remove(node)
    print(node, end="")
    if node==goal:
        print("\n Goal Found........")
        break
    for x in graph[node]:
        open.append(x)
